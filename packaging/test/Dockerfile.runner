# Image of the `test` Compose service: the Go toolchain plus the Docker CLI and
# Compose plugin that the deploy integration tests (run against the dind
# sidecar) shell out to.
# Keep the Compose plugin in step with the main Dockerfile.
FROM golang:1.26.2-bookworm
COPY --from=docker:28-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker/compose-bin:v5.1.0 /docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose
