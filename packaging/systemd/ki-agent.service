[Unit]
Description=ki-agent server management agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ki-agent run
User=ki-agent
Group=ki-agent
Restart=on-failure
RestartSec=2s

# /run/ki-agent (socket) and /var/lib/ki-agent (data) are managed by systemd.
RuntimeDirectory=ki-agent
RuntimeDirectoryMode=0750
StateDirectory=ki-agent
StateDirectoryMode=0750

# Sandboxing: the data directory is the only writable path.
ProtectSystem=strict
ReadWritePaths=/var/lib/ki-agent
# The docker client config (registry logins) defaults to /var/lib/ki-agent/docker;
# a docker.config_dir elsewhere must be added to ReadWritePaths in a drop-in.
# `systemctl show` (AWS agent detection) only needs the system bus socket, which
# these settings leave reachable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

# Docker socket access. Membership of the docker group is root-equivalent on
# the host, which is why the agent only touches containers it labelled itself
# and why compose projects are checked against a safety policy before they run.
SupplementaryGroups=docker

[Install]
WantedBy=multi-user.target
